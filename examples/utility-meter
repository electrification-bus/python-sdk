class UtilityMeterAdapter:
    """
    Translates a UtilityMeter to a Homie 5 device on the eBus broker.

    Creates one root device of type `energy.ebus.device.utility-meter` with
    eight capability nodes (`info`, `meter`, `status`, `grid`, `doe`, `price`,
    `demand`, `power-quality`). Each Homie
    property is mirrored from the corresponding UtilityMeter property via a
    callback.
    """

    def __init__(
        self,
        meter: UtilityMeter,
        device_id: str,
        device_name: str,
        mqtt_cfg: Dict[str, Any],
        logger: Optional[logging.Logger] = None,
    ):
        self._logger = logger or _make_logger(self.__class__.__name__)
        self._meter = meter
        self._device_id = device_id
        self._device_name = device_name
        self._mqtt_cfg = mqtt_cfg
        self._homie_device: Optional[homie.Device] = None
        self._create_device_and_nodes()

    def stop(self) -> None:
        """Announce `disconnected` for the meter and disconnect cleanly."""
        if self._homie_device is not None:
            self._homie_device.stop()

    def homie_domain(self) -> str:
        """The Homie domain the meter publishes under."""
        return self._homie_device.homie_domain()

    @staticmethod
    def load_broker_config(config_file: str) -> Dict[str, Any]:
        with open(config_file, "r") as fp:
            return json.load(fp)

    # ── homie device + nodes ──

    def _create_homie_device(self) -> homie.Device:
        device = homie.Device(
            self._device_id,
            name=self._device_name,
            type=DEVICE_TYPE,
            mqtt_cfg=self._mqtt_cfg,
        )
        device.start_mqtt_client()
        return device

    def _add_capability_node(
        self,
        node_id: str,
        node_type: str,
        node_name: str,
        meter_group: str,
    ) -> homie.Node:
        node = self._homie_device.add_node_from_dict({"id": node_id, "name": node_name, "type": node_type})
        self._homie_nodes[meter_group] = node
        if not self._meter._props.has_group(meter_group):
            # Empty capability node — properties may be added at runtime
            # (e.g. doe values arriving via the HTTP endpoint). The
            # PROPERTY_ADDED observer registered below will mirror them
            # to Homie when they arrive.
            return node
        for prop_id, prop in self._meter._props.items(meter_group):
            self._add_homie_property(node, meter_group, prop_id, prop)
        return node

    def _add_homie_property(
        self,
        node: homie.Node,
        meter_group: str,
        prop_id: str,
        prop: Property,
    ):
        """
        Add a single Homie property to `node`, mirroring the meter
        Property `prop`, and wire a change callback so subsequent
        set_value() calls on the meter property republish to Homie.
        Used both at startup (for properties seeded from config) and at
        runtime (for properties added by the PROPERTY_ADDED observer).
        """
        if prop_id in self._homie_property_ids.get(meter_group, set()):
            return  # already mirrored
        hint = HOMIE_PROPERTY_HINTS.get(meter_group, {}).get(prop_id, {})
        property_dict = {"id": prop_id, "value": prop.value()}
        if "datatype" in hint:
            property_dict["datatype"] = hint["datatype"]
        else:
            inferred = homie.datatype_from_type(prop.type())
            if inferred:
                property_dict["datatype"] = inferred
        if "unit" in hint:
            property_dict["unit"] = hint["unit"]
        if "format" in hint:
            # $format: a JSONSchema (json properties) or an enum value list.
            property_dict["format"] = hint["format"]
        homie_property = node.add_property_from_dict(property_dict)
        self._meter.add_property_on_change_callback(
            meter_group,
            prop_id,
            partial(_set_homie_property_from_property, homie_property),
        )
        self._homie_property_ids.setdefault(meter_group, set()).add(prop_id)

    def _on_meter_property_event(
        self,
        event_type: ChangeEvent,
        group_name: str = None,
        property_id: str = None,
        property: Property = None,
        **kwargs,
    ):
        """
        Observer callback for the meter's GroupedPropertyDict. Mirrors
        runtime-added properties (e.g. doe values arriving via HTTP after
        startup) to Homie.
        """
        if event_type != ChangeEvent.PROPERTY_ADDED:
            return
        node = self._homie_nodes.get(group_name)
        if node is None:
            self._logger.warning(
                "reason=runtimePropertyAddUnknownGroup,group=%s,propertyId=%s",
                group_name,
                property_id,
            )
            return
        self._add_homie_property(node, group_name, property_id, property)

    def _create_device_and_nodes(self):
        self._homie_device = self._create_homie_device()
        self._homie_nodes: Dict[str, homie.Node] = {}
        self._homie_property_ids: Dict[str, set] = {}
        self._add_capability_node("info", CAPABILITY_INFO, "Meter identity", "info")
        self._add_capability_node(
            "meter",
            CAPABILITY_METER,
            "Electrical measurements",
            "meter",
        )
        self._add_capability_node("status", CAPABILITY_STATUS, "Meter operational state", "status")
        self._add_capability_node("grid", CAPABILITY_GRID, "Utility supply health", "grid")
        self._add_capability_node("doe", CAPABILITY_DOE, "Utility-signalled operating envelope", "doe")
        self._add_capability_node("price", CAPABILITY_PRICE, "Utility-signalled dynamic price", "price")
        self._add_capability_node("demand", CAPABILITY_DEMAND, "Peak-average demand", "demand")
        self._add_capability_node(
            "power-quality", CAPABILITY_POWER_QUALITY, "Power-quality measurements", "power-quality"
        )
        # Observe runtime property additions so values arriving after
        # device startup (typical for doe via the HTTP endpoint) are
        # mirrored onto Homie.
        self._meter._props.add_observer(
            self._on_meter_property_event,
            event_types=[ChangeEvent.PROPERTY_ADDED],
        )


# ─── DOE HTTP endpoint ────────────────────────────────────────────────────────


# Map POST path to (UtilityMeter setter method, the property's $format schema).
# Both doe and price are json-array schedules driven out of band; here the HTTP
# endpoint stands in for the utility backhaul.
_SCHEDULE_PATHS = {
    "/doe/import-limit": ("set_doe_import_limit", DOE_LIMIT_FORMAT),
    "/doe/export-limit": ("set_doe_export_limit", DOE_LIMIT_FORMAT),
    "/price/import-price": ("set_import_price", PRICE_FORMAT),
    "/price/export-price": ("set_export_price", PRICE_FORMAT),
}


def _normalize_and_validate(body: Any, schema: dict) -> Optional[list]:
    """Normalize a posted json body into a schedule array and validate it.

    Accepts None (clear the signal), a single object, or an array of objects; a
    lone object is wrapped in a one-element array. The normalized array is
    validated against the property's `$format` JSONSchema with the SDK's
    `homie.validate_json_format` (the same schema the property advertises), which
    is a graceful no-op when the optional `jsonschema` package is not installed.
    Raises ValueError on a malformed or schema-invalid body.
    """
    if body is None:
        return None
    items = [body] if isinstance(body, dict) else body
    if not isinstance(items, list):
        raise ValueError("body must be an object, an array, or null")
    error = homie.validate_json_format(items, schema)
    if error is not None:
        raise ValueError(error)
    return items


class _DoeRequestHandler(BaseHTTPRequestHandler):
    """Tiny HTTP handler accepting DOE updates as JSON."""

    meter: UtilityMeter = None  # type: ignore[assignment]

    def log_message(self, format, *args):
        logging.getLogger("DoeEndpoint").info(
            "%s - - [%s] %s",
            self.address_string(),
            self.log_date_time_string(),
            format % args,
        )

    def do_POST(self):
        entry = _SCHEDULE_PATHS.get(self.path)
        if entry is None:
            self._reply(HTTPStatus.NOT_FOUND, {"error": "unknown path", "known": sorted(_SCHEDULE_PATHS)})
            return
        setter_name, schema = entry
        length = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(length).decode("utf-8") if length else ""
        try:
            # An empty body clears the signal for this direction (same as null).
            body = json.loads(raw) if raw.strip() else None
        except Exception as exc:
            self._reply(HTTPStatus.BAD_REQUEST, {"error": f"invalid json: {exc}"})
            return
        try:
            items = _normalize_and_validate(body, schema)
        except ValueError as exc:
            self._reply(HTTPStatus.BAD_REQUEST, {"error": str(exc)})
            return
        try:
            getattr(self.meter, setter_name)(items)
        except Exception as exc:
            self._reply(HTTPStatus.INTERNAL_SERVER_ERROR, {"error": str(exc)})
            return
        self._reply(
            HTTPStatus.OK,
            {"applied": {"path": self.path, "items": items, "at": datetime.now(timezone.utc).isoformat()}},
        )

    def _reply(self, status: HTTPStatus, payload: dict):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def start_doe_endpoint(meter: UtilityMeter, port: int) -> ThreadingHTTPServer:
    handler = type("BoundDoeRequestHandler", (_DoeRequestHandler,), {"meter": meter})
    server = ThreadingHTTPServer(("127.0.0.1", port), handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    logging.getLogger("ScheduleEndpoint").info(
        "reason=scheduleEndpointReady,port=%d,paths=%s", port, ",".join(sorted(_SCHEDULE_PATHS))
    )
    return server


# ─── Periodic tick ────────────────────────────────────────────────────────────


def start_tick_thread(meter: UtilityMeter, interval_s: float) -> threading.Event:
    stop = threading.Event()

    def _run():
        while not stop.is_set():
            try:
                meter.tick()
            except Exception:
                logging.exception("reason=tickException")
            stop.wait(interval_s)

    threading.Thread(target=_run, daemon=True).start()
    return stop


# ─── Entry point ──────────────────────────────────────────────────────────────


def _discover_broker(mqtt_cfg: Dict[str, Any], timeout: float, log: logging.Logger) -> Optional[Dict[str, Any]]:
    """Discover an eBus broker over mDNS with ebus-service-discovery.

    Returns a copy of `mqtt_cfg` with the discovered broker's host, port and
    `use_tls` (the host is the advertised `broker` TXT value, the name the
    broker's certificate covers, else the SRV target), or None when no broker
    is found within `timeout` seconds. A TLS config accepts only
    `_secure-mqtt._tcp`. When the config names a `host`, only a discovered
    broker that is that host is used (another broker never receives this
    config's credentials); otherwise the first ranked broker. Requires the
    `mdns` extra.
    """
    try:
        from ebus_service_discovery import mdns
        from ebus_service_discovery.ebus import (
            SECURE_MQTT_SERVICE,
            TCP_BROKER_TYPES,
            BrokerEndpoint,
            match_configured,
            rank_brokers,
        )
    except ImportError:
        log.error("discovery needs the 'mdns' extra: pip install 'ebus-sdk[mdns]'")
        return None

    # The steps of mdns.find_broker(), driven here so that each browse ends by
    # the deadline: find_broker's browse window is fixed for the whole call.
    accept = (SECURE_MQTT_SERVICE,) if mqtt_cfg.get("use_tls") else TCP_BROKER_TYPES
    configured = BrokerEndpoint.from_mqtt_cfg(mqtt_cfg) if mqtt_cfg.get("host") else None
    deadline = time.monotonic() + timeout
    zc = mdns.new_zeroconf()
    try:
        while (remaining := deadline - time.monotonic()) > 0:
            found = mdns.browse_many(accept, min(3.0, remaining), zc)
            usable = rank_brokers((BrokerEndpoint.from_instance(i) for i in found), accept=accept)
            chosen = usable[0] if configured is None and usable else None
            if configured is not None:
                chosen = match_configured(configured, usable)
            if chosen is not None:
                return chosen.mqtt_cfg(mqtt_cfg)
    finally:
        zc.close()
    return None


def _identity_from_info(device_id: str, info: Dict[str, Any], homie_domain: str):
    """The `_ebus._tcp` / `_device-info._tcp` identity from the meter's `info` config.

    `homie_domain` adds the `homie_domain`, `homie_version` and `homie_roles` TXT keys.
    """
    from ebus_service_discovery.ebus import Identity

    return Identity(
        device_ids=[device_id],
        roles=["device"],
        manufacturer=str(info.get("vendor-name") or "unknown"),
        model=str(info.get("model") or "unknown"),
        serial_number=str(info.get("serial-number") or device_id),
        fw_version=str(info["firmware-version"]) if info.get("firmware-version") else None,
        device_type=DEVICE_TYPE,
        homie_domain=homie_domain,
    )


def _start_advertiser(device_id: str, info: Dict[str, Any], homie_domain: str, log: logging.Logger):
    """Advertise `_ebus._tcp` and `_device-info._tcp` (framework.md requirement 6).

    Returns the running `mdns.Advertiser`, or None when the `mdns` extra is not
    installed or advertising fails; the meter runs either way.
    """
    try:
        from ebus_service_discovery import mdns
    except ImportError:
        log.warning("reason=advertiseSkipped,detail=mdns extra not installed (pip install 'ebus-sdk[mdns]')")
        return None
    try:
        advertiser = mdns.Advertiser(_identity_from_info(device_id, info, homie_domain)).start()
    except Exception as exc:
        log.warning("reason=advertiseFailed,error=%s", exc)
        return None
    log.info("reason=advertising,instance=%s,server=%s", advertiser.instance_name, advertiser.server)
    return advertiser


def main():
    parser = argparse.ArgumentParser(description=("eBus utility-meter publisher reference implementation."))
    parser.add_argument(
        "-c",
        "--config",
        required=True,
        help="Path to the meter config JSON file (see utility-meter-cfg.example.json).",
    )
    parser.add_argument(
        "-b",
        "--broker-config",
        help=f"Path to the MQTT broker config JSON file. Defaults to ${DEFAULT_BROKER_CFG_ENV} env var.",
    )
    parser.add_argument(
        "--discover",
        action="store_true",
        help="Discover the broker over mDNS and use the advertised host/port, "
        "overriding 'host'/'port' in the broker config. A TLS broker config "
        "accepts only _secure-mqtt._tcp. The broker config still supplies the "
        "TLS material and credentials.",
    )
    parser.add_argument(
        "--discover-timeout",
        type=float,
        default=8.0,
        help="Seconds to wait for mDNS broker discovery (default: 8.0).",
    )
    parser.add_argument(
        "--no-advertise",
        action="store_true",
        help="Do not advertise _ebus._tcp / _device-info._tcp over mDNS "
        "(advertised by default when the mdns extra is installed).",
    )
    parser.add_argument(
        "--doe-port",
        type=int,
        default=DEFAULT_DOE_ENDPOINT_PORT,
        help=f"Port for the local DOE HTTP endpoint (default: {DEFAULT_DOE_ENDPOINT_PORT}).",
    )
    parser.add_argument(
        "--tick-interval",
        type=float,
        default=5.0,
        help="Interval in seconds for tick(), currently an unimplemented stub (default: 5.0).",
    )
    args = parser.parse_args()

    # Logging
    logging.basicConfig()
    log = _make_logger("utility-meter")

    # Meter config
    with open(args.config, "r") as fp:
        meter_cfg = json.load(fp)

    # Broker config
    broker_cfg_path = args.broker_config or os.environ.get(DEFAULT_BROKER_CFG_ENV)
    if not broker_cfg_path:
        log.error(
            "no broker config; pass --broker-config or set %s",
            DEFAULT_BROKER_CFG_ENV,
        )
        sys.exit(2)
    mqtt_cfg = UtilityMeterAdapter.load_broker_config(broker_cfg_path)

    # Prefer an mDNS-discovered broker over the config's explicit host, per the
    # eBus broker-discovery flow. The broker config still supplies the TLS
    # material; discovery only fills in where to connect.
    if args.discover:
        discovered = _discover_broker(mqtt_cfg, args.discover_timeout, log)
        if discovered is not None:
            mqtt_cfg = discovered
            log.info(
                "reason=brokerDiscovered,host=%s,port=%d",
                mqtt_cfg["host"],
                mqtt_cfg["port"],
            )
        elif mqtt_cfg.get("host"):
            log.warning(
                "reason=brokerDiscoveryTimeout,fallbackHost=%s",
                mqtt_cfg["host"],
            )
        else:
            log.error("broker discovery failed and no fallback 'host' in broker config")
            sys.exit(2)

    # Resolve device identity from config
    device_id = meter_cfg.get("device-id") or meter_cfg.get("info", {}).get("serial-number")
    device_name = meter_cfg.get("device-name", "Utility Meter")
    if not device_id:
        log.error("no device-id (and no info.serial-number) in meter config")
        sys.exit(2)

    # Wire it up. Constructing the adapter creates the Homie device, its
    # capability nodes, and starts the MQTT client.
    meter = UtilityMeter(meter_cfg, logger=_make_logger("UtilityMeter"))
    adapter = UtilityMeterAdapter(
        meter,
        device_id=device_id,
        device_name=device_name,
        mqtt_cfg=mqtt_cfg,
        logger=_make_logger("UtilityMeterAdapter"),
    )
    start_doe_endpoint(meter, args.doe_port)
    start_tick_thread(meter, args.tick_interval)
    advertiser = (
        None
        if args.no_advertise
        else _start_advertiser(device_id, meter_cfg.get("info", {}), adapter.homie_domain(), log)
    )

    log.info(
        "reason=utilityMeterReady,deviceId=%s,deviceType=%s",
        device_id,
        DEVICE_TYPE,
    )

    # Wait until Ctrl-C, then shut down cleanly: stop() publishes
    # $state=disconnected before disconnecting.
    try:
        threading.Event().wait()
    except KeyboardInterrupt:
        if advertiser is not None:
            advertiser.stop()
        adapter.stop()
        raise


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
    except Exception as e:
        logging.exception(e)
        sys.exit(1)
