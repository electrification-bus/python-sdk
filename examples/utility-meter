# ─── Logger boilerplate ───────────────────────────────────────────────────────


def _make_logger(name: str, level: int = logging.INFO) -> logging.Logger:
    logger = logging.getLogger(name)
    logger.setLevel(level)
    if not logger.handlers:
        handler = logging.StreamHandler()
        handler.setFormatter(logging.Formatter("%(asctime)s - %(name)s - %(levelname)s - %(message)s"))
        logger.addHandler(handler)
    return logger


# ─── Pure model: utility-meter state ──────────────────────────────────────────


class UtilityMeter:
    """
    Pure-Python model of the utility meter's published state.

    Holds the values for `info`, `meter`, `status`, and `doe` properties.
    Knows nothing about MQTT — the adapter below translates this state to
    Homie/eBus topics.

    Values change via `set_doe_*` methods (driven by the HTTP DOE endpoint).
    A periodic thread also calls `tick()`, which is an unimplemented stub, so
    meter measurements stay at their configured values. Subscribers register
    callbacks via
    `add_property_on_change_callback`.
    """

    def __init__(
        self,
        config: Dict[str, Any],
        logger: Optional[logging.Logger] = None,
    ):
        self._logger = logger or _make_logger(self.__class__.__name__)
        self._config = config
        self._props = GroupedPropertyDict()
        self._populate_info()
        self._populate_meter()
        self._populate_status()
        self._populate_scalars("grid")
        self._populate_scalars("demand")
        self._populate_scalars("power-quality")
        self._populate_doe()
        self._populate_price()

    # ── info ──

    def _populate_info(self):
        """Static nameplate properties from config."""
        info = self._config.get("info", {})
        # TODO: validate that the standard `info` properties from the
        # eBus utility-meter data model are populated (vendor-name, model,
        # serial-number, meter-form, meter-class, phases, neutral-connected,
        # nominal-frequency, nominal-phase-angle, nominal-voltage-*).
        for key, value in info.items():
            self._props.add_property_from_dict("info", {"id": key, "type": type(value), "value": value})

    # ── meter ──

    def _populate_meter(self):
        """Synthesised instantaneous + cumulative measurements."""
        # TODO: drive these from a synthetic-load model rather than static
        # config so the demo is more illustrative. For scaffold purposes,
        # config-supplied values are sufficient.
        meter = self._config.get("meter", {})
        for key, value in meter.items():
            self._props.add_property_from_dict("meter", {"id": key, "type": type(value), "value": value})

    # ── status ──

    def _populate_status(self):
        defaults = {
            "communication-state": "OK",
            "time-sync-state": "LOCKED",
        }
        defaults.update(self._config.get("status", {}))
        for key, value in defaults.items():
            self._props.add_property_from_dict("status", {"id": key, "type": type(value), "value": value})

    # ── grid / demand / power-quality (scalar measurement capabilities) ──

    def _populate_scalars(self, group: str):
        """Seed a scalar-measurement capability's properties from config.

        Optional utility-meter capabilities (`grid`, `demand`, `power-quality`)
        that a meter publishes only when it senses them. The example seeds
        representative values from config; a real meter would drive these from
        its measurement hardware. Datatype/unit/`$format` come from
        `HOMIE_PROPERTY_HINTS`; the published set is whatever config supplies.
        """
        for key, value in self._config.get(group, {}).items():
            self._props.add_property_from_dict(group, {"id": key, "type": type(value), "value": value})

    # ── doe ──

    def _populate_doe(self):
        """
        Initial DOE envelopes from config. May be empty / absent — DOE is
        publish-on-change and a meter that signals no envelope simply omits
        the property. Config supplies `doe.import-limit` / `doe.export-limit`
        as JSON arrays of envelope objects; each becomes one `json` property.
        """
        doe = self._config.get("doe", {})
        for direction in DOE_DIRECTIONS:
            envelopes = doe.get(direction)
            if envelopes:
                self._props.add_property_from_dict(
                    "doe",
                    {"id": direction, "type": "json", "value": list(envelopes)},
                )

    def set_doe_import_limit(self, envelopes):
        """Set the import-side DOE schedule atomically. See `_set_json_schedule`."""
        self._set_json_schedule("doe", "import-limit", envelopes)

    def set_doe_export_limit(self, envelopes):
        """Set the export-side DOE schedule atomically. See `_set_json_schedule`."""
        self._set_json_schedule("doe", "export-limit", envelopes)

    def _set_or_clear(self, group, prop_id, value, py_type):
        try:
            existing = self._props.get(group, prop_id)
        except KeyError:
            existing = None
        if existing is None:
            if value is not None:
                self._props.add_property_from_dict(group, {"id": prop_id, "type": py_type, "value": value})
        else:
            existing.set_value(value)

    # ── price ──

    def _populate_price(self):
        """Initial price schedules from config (`price.import-price` /
        `price.export-price`), each a JSON array of price-window objects. Like
        `doe`, publish-on-change: a direction with no signal simply omits the
        property. See `capabilities/price.md`."""
        price = self._config.get("price", {})
        for direction in PRICE_DIRECTIONS:
            windows = price.get(direction)
            if windows:
                self._props.add_property_from_dict("price", {"id": direction, "type": "json", "value": list(windows)})

    def set_import_price(self, windows):
        """Set the import-price schedule atomically. See `_set_json_schedule`."""
        self._set_json_schedule("price", "import-price", windows)

    def set_export_price(self, windows):
        """Set the export-price schedule atomically. See `_set_json_schedule`."""
        self._set_json_schedule("price", "export-price", windows)

    def _set_json_schedule(self, group: str, prop_id: str, items):
        """Set one json-array schedule property (doe envelope / price window)
        atomically. `items` is a single object, a list of them, or None to
        clear. Shared by the doe and price runtime-update paths."""
        if items is None:
            value = None
        elif isinstance(items, dict):
            value = [items]
        else:
            value = list(items)
        self._set_or_clear(group, prop_id, value, "json")

    # ── tick (periodic synthetic update) ──

    def tick(self):
        """
        Called periodically to nudge meter measurements so consumers can see
        live changes. Scaffold: TODO — implement synthetic load model.
        """
        # TODO: synthesise plausible variation on active-power / voltage /
        # current; advance imported-energy / exported-energy counters.
        pass

    # ── callback registration ──

    def add_property_on_change_callback(self, group, prop_id, callback):
        return self._props.add_property_on_change_callback(group, prop_id, callback)

    def get_property(self, group, prop_id) -> Property:
        return self._props.get(group, prop_id)

    def as_dict(self) -> dict:
        return self._props.as_dict()


