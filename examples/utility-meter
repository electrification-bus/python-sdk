CAPABILITY_POWER_QUALITY = "energy.ebus.capability.power-quality"

# doe capability: two json properties, one per direction. Each holds a JSON
# array of envelope objects per capabilities/doe.md.
DOE_DIRECTIONS = ("import-limit", "export-limit")

# price capability: two json properties, one per direction. Each holds a JSON
# array of price-window objects per capabilities/price.md.
PRICE_DIRECTIONS = ("import-price", "export-price")

